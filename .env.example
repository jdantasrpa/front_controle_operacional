# ============================================================
# SCO — variáveis de ambiente (TEMPLATE)
#
# Copie para .env (que o .gitignore já ignora) e preencha com os valores
# reais. NUNCA versione o .env nem cole segredos no front/GitHub Pages.
#
#   cp .env.example .env      (Linux/Mac)
#   copy .env.example .env    (Windows)
# ============================================================

# ------------------------------------------------------------
# PÚBLICO — pode ficar no front (GitHub Pages). É público por design.
#   Supabase: Dashboard > Project Settings > API
# ------------------------------------------------------------
SUPABASE_URL=https://SEU-REF.supabase.co
SUPABASE_ANON_KEY=cole-a-anon-public-key-aqui

# ------------------------------------------------------------
# SECRETO — SOMENTE no backend. NUNCA no front nem no GitHub.
#   service_role ignora RLS: quem tiver essa chave lê/escreve tudo.
#   Supabase: Dashboard > Project Settings > API (service_role)
# ------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=cole-a-service-role-key-aqui

# Conexão direta ao Postgres (para migrations / psql / supabase db push).
#   Supabase: Dashboard > Project Settings > Database > Connection string (URI)
#   Contém a SENHA do banco — trate como segredo.
SUPABASE_DB_URL=postgresql://postgres:SENHA@db.SEU-REF.supabase.co:5432/postgres

# ------------------------------------------------------------
# CHAVE-MESTRA da criptografia da empresa (AES-256-GCM). SECRETA.
#   Gere uma vez com:
#     python -c "from api.cripto import gerar_chave_mestra; print(gerar_chave_mestra())"
#   Só no backend. Perder a chave = dados cifrados irrecuperáveis.
# ------------------------------------------------------------
SCO_CHAVE_MESTRA=cole-a-chave-base64-de-32-bytes-aqui
